# Public address of this storefront, e.g. https://fragrancebyshoon.com
# Used for canonical links, sitemap.xml, robots.txt and Google structured data. Must be the live domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public URL of the backend API (images are served from here too).
NEXT_PUBLIC_API_URL=http://localhost:4000

# Optional: URL the Next.js server uses to reach the API (e.g. an internal Docker hostname).
# Defaults to NEXT_PUBLIC_API_URL.
API_INTERNAL_URL=

# Allow next/image to optimize images from a localhost/private-network backend.
# Keep true for local development; set false when the API has a public hostname.
IMAGES_ALLOW_LOCAL_IP=true
